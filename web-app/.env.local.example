# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# OpenAI
OPENAI_API_KEY=sk-...

# hCaptcha (free tier)
HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000

# v0 Platform API
V0_API_KEY=your-v0-api-key

# Site collaboration invites
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Brand Kit Generator <invites@example.com>
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Local-only dev auth helper. Never enable in production.
DEV_AUTH_ENABLED=false
DEV_AUTH_EMAIL=dev@example.com

# Hackathon demo lane. Keep disabled unless you need the protected /demo flow.
DEMO_MODE_ENABLED=false
DEMO_USER_EMAIL=demo@example.com
DEMO_FALLBACK_DEMO_URL=

# Local agent/MCP access. Use a long random value outside development.
BRANDKIT_AGENT_TOKEN=dev-agent-token
AGENT_USER_EMAIL=agent@brandkit.local
BRANDKIT_AGENT_BASE_URL=http://localhost:3002
